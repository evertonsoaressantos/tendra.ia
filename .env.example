# Copy to .env.local; replace empty keys with local Supabase values.
# No real provider is called by default. Never commit actual credentials.
AI_MODE=fixture
APP_ORIGIN=http://localhost:3000
PIPELINE_VERSION=v1
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL_APP=postgresql://tendra_app@127.0.0.1:54322/postgres
DATABASE_URL_WORKER_DOMAIN=postgresql://tendra_worker@127.0.0.1:54322/postgres
DATABASE_URL_QUEUE=postgresql://tendra_queue@127.0.0.1:54322/postgres
# Only inject the following into migration commands, never web/worker processes.
DATABASE_URL_MIGRATION=postgresql://tendra_migration@127.0.0.1:54322/postgres
GENERATION_MODEL=gpt-4.1-mini-2025-04-14
EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY must only be supplied for explicitly authorized provider runs.
